DB_PORT=5432
DB_USER=demo
DB_PASSWORD=demo
DB_NAME=demo

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# MQTT Configuration
MQTT_BROKER=114.55.211.112
MQTT_PORT=1883
